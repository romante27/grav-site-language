{% import 'macros/icons.html.twig' as ui %}
{% set plate = page.header.plate|default({}) %}
<section class="section section--about" id="about">
    <div class="container">
        <div class="split split--about">
            <div class="about-plate" data-reveal>
                <div class="type-plate">
                    <span class="type-plate__label">{{ plate.label|default('A note on language') }}</span>
                    <span class="type-plate__letter" aria-hidden="true">{{ plate.letter|default('Aa') }}</span>
                    <span class="type-plate__ipa">{{ plate.ipa|default('/ˈɪŋ.ɡlɪʃ/') }}</span>
                    <span class="type-plate__rule" aria-hidden="true"></span>
                    <blockquote class="type-plate__quote">
                        {{ plate.quote|default('Language is the dress of thought.') }}
                        <cite>{{ plate.cite|default('Samuel Johnson') }}</cite>
                    </blockquote>
                    <span class="type-plate__mark">AB · MMXIV</span>
                </div>
                <span class="about-plate__caption">A room of one’s own — и хороший словарь</span>
            </div>

            <div class="about-copy">
                <p class="eyebrow" data-reveal>{{ page.header.eyebrow }}</p>
                <h2 data-reveal style="--d: .05s">{{ page.header.heading|raw }}</h2>
                <div class="about-copy__text" data-reveal style="--d: .1s">
                    {% for paragraph in page.header.paragraphs %}
                    <p>{{ paragraph.text|default(paragraph) }}</p>
                    {% endfor %}
                </div>
                <div class="signature" data-reveal style="--d: .15s">
                    <span class="signature__name">{{ page.header.signature|default('Анна Белова') }}</span>
                    <span class="signature__role">{{ page.header.signature_role|default('преподаватель английского, CELTA') }}</span>
                </div>
                <a class="text-link" href="{{ page.header.link_url|default(base_url_relative ~ '/about') }}" data-reveal style="--d: .2s">
                    <span>{{ page.header.link_label|default('Познакомиться ближе') }}</span>
                    {{ ui.icon('arrow-right', 'icon icon--sm') }}
                </a>
            </div>
        </div>

        {% if page.header.stats %}
        <ul class="stats" aria-label="Ключевые цифры">
            {% for stat in page.header.stats %}
            <li class="stat" data-reveal style="--d: {{ loop.index0 * 0.08 }}s">
                <span class="stat__value">
                    <span data-counter data-value="{{ stat.value }}" data-decimals="{{ stat.decimals|default(0) }}">{{ stat.value }}</span><span class="stat__suffix">{{ stat.suffix|default('') }}</span>
                </span>
                <span class="stat__label">{{ stat.label }}</span>
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>
</section>
